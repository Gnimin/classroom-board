<Window x:Class="NEWCLASSroom.Views.MessageOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="班级消息"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Grid>
        <Rectangle Fill="#E6080C16"/>

        <Grid Margin="70,60,70,64">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                <Border x:Name="BadgeBox" Background="#E0413A" CornerRadius="12" Padding="22,10">
                    <TextBlock x:Name="TxtBadge" Text="老师留言" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF"/>
                </Border>
                <TextBlock x:Name="TxtTime" Text="" FontSize="22" Foreground="#8EA0BE"
                           VerticalAlignment="Center" Margin="20,0,0,0"/>
            </StackPanel>

            <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="30,40,30,30">
                <TextBlock x:Name="TxtMessage" Text="某某同学来办公室"
                           FontSize="150" FontWeight="Bold" Foreground="#FFFFFF"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="1500"/>
            </Viewbox>

            <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                <Border x:Name="AckButton" Background="#FFFFFF" CornerRadius="16" Padding="54,18"
                        Visibility="Collapsed" Cursor="Hand" MouseLeftButtonUp="OnAckClick">
                    <TextBlock Text="知道了" FontSize="32" FontWeight="Bold" Foreground="#101A2C"/>
                </Border>
                <TextBlock x:Name="TxtAutoClose" Text="" FontSize="18" Foreground="#7D8CA8"
                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
