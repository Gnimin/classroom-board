<Window x:Class="NEWCLASSroom.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="班牌设置"
        Width="760" Height="680"
        WindowStartupLocation="CenterScreen"
        Background="#F6F8FC"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="14">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="BorderBrush" Value="#D3DAE6"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="16,16,16,10" Background="White" BorderBrush="#E1E7F0">

            <TabItem Header="显示">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,20">
                        <TextBlock Text="班牌显示方式" Style="{StaticResource Label}" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbDisplayMode" SelectedIndex="0">
                            <ComboBoxItem Content="置底窗口（铺满全屏，会遮住桌面图标）"/>
                            <ComboBoxItem Content="右侧停靠（只占右半边，左边图标照常可见）"/>
                            <ComboBoxItem Content="桌面壁纸层（图标浮在上面，最像壁纸）"/>
                        </ComboBox>
                        <TextBlock Text="壁纸层依赖系统的 WorkerW 结构，个别 Windows 版本挂不上，程序会自动退回置底窗口。"
                                   Foreground="#8794A8" FontSize="12.5" TextWrapping="Wrap" Margin="0,-8,0,18"/>

                        <TextBlock Text="主题配色" Style="{StaticResource Label}" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbTheme" SelectedIndex="0">
                            <ComboBoxItem Content="深色（黑底白字，教室大屏更醒目）"/>
                            <ComboBoxItem Content="浅色（白底黑字，像纸质的课程表）"/>
                        </ComboBox>
                        <TextBlock Text="换主题立刻生效，不用重启。"
                                   Foreground="#8794A8" FontSize="12.5" TextWrapping="Wrap" Margin="0,-8,0,18"/>

                        <TextBlock Text="显示在哪一块屏幕" Style="{StaticResource Label}" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbMonitor"/>

                        <TextBlock Text="无操作全屏（类似屏保）" Style="{StaticResource Label}" FontWeight="SemiBold"/>
                        <CheckBox x:Name="ChkIdle" Content="班牌收起后，长时间没人用电脑就全屏显示班牌"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="空闲超过" VerticalAlignment="Center" Foreground="#4A5568"/>
                            <TextBox x:Name="TxtIdleMinutes" Width="60" Margin="10,0" TextAlignment="Center"/>
                            <TextBlock Text="分钟自动全屏，动一下鼠标立刻消失" VerticalAlignment="Center" Foreground="#4A5568"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Button x:Name="BtnToggleBoard" Content="收起班牌" Click="OnToggleBoard"
                                    Padding="14,6" Margin="0,0,12,0"/>
                            <TextBlock x:Name="TxtIdleHint" VerticalAlignment="Center" Foreground="#8794A8"
                                       FontSize="12.5" TextWrapping="Wrap" MaxWidth="460"/>
                        </StackPanel>

                        <CheckBox x:Name="ChkAutoStart" Content="开机自动启动班牌"/>
                        <TextBlock x:Name="TxtDisplayStatus" Foreground="#8794A8" FontSize="12.5" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="班级">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,20">
                        <TextBlock Text="学校名称" Style="{StaticResource Label}" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtSchool"/>
                        <TextBlock Text="班级名称" Style="{StaticResource Label}" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtClass"/>
                        <TextBlock Text="班牌左上角显示这两行字，手机端也可以改。" Foreground="#8794A8" FontSize="12.5"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="消息与语音">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,20">
                        <TextBlock Text="消息弹窗停留时间（秒）" Style="{StaticResource Label}" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtDuration" Width="120" HorizontalAlignment="Left"/>
                        <TextBlock Text="点“立即试一条”可以看看实际效果，紧急消息不会自动消失。" Foreground="#8794A8"
                                   FontSize="12.5" TextWrapping="Wrap" Margin="0,-8,0,16"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Button x:Name="BtnTestMessage" Content="立即试一条" Click="OnTestMessage"/>
                        </StackPanel>

                        <CheckBox x:Name="ChkSpeech" Content="收到消息时用语音念一遍"/>
                        <TextBlock Text="朗读语音" Style="{StaticResource Label}" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbVoice"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="语速（-10 慢 / 10 快）" Style="{StaticResource Label}"/>
                                <TextBox x:Name="TxtRate"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="音量（0-100）" Style="{StaticResource Label}"/>
                                <TextBox x:Name="TxtVolume"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button x:Name="BtnTestVoice" Content="试听语音" Click="OnTestVoice"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtVoiceStatus" Foreground="#8794A8" FontSize="12.5" TextWrapping="Wrap" Margin="0,14,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="手机端">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="端口" Style="{StaticResource Label}" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtPort" Width="120" HorizontalAlignment="Left"/>

                                <TextBlock Text="访问口令" Style="{StaticResource Label}" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtPin" Width="180" HorizontalAlignment="Left"/>
                                <TextBlock Text="手机打开网页后要先输入这个口令，防止学生乱发消息。留空表示不校验。"
                                           Foreground="#8794A8" FontSize="12.5" TextWrapping="Wrap" Margin="0,-8,0,18"/>

                                <TextBlock Text="局域网地址" Style="{StaticResource Label}" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtLanUrl" IsReadOnly="True" Background="#F2F5FA"/>

                                <TextBlock Text="外网地址" Style="{StaticResource Label}" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtPublicUrl" IsReadOnly="True" Background="#F2F5FA"/>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button x:Name="BtnOpenWeb" Content="在本机打开" Click="OnOpenWeb"/>
                                    <Button x:Name="BtnCopyUrl" Content="复制地址" Click="OnCopyUrl"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtServerStatus" Foreground="#8794A8" FontSize="12.5"
                                           TextWrapping="Wrap" Margin="0,14,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1" Background="White" BorderBrush="#E1E7F0" BorderThickness="1"
                                    CornerRadius="10" Padding="10" VerticalAlignment="Top">
                                <StackPanel>
                                    <Image x:Name="ImgQr" Width="180" Height="180" Stretch="Uniform"/>
                                    <TextBlock Text="扫码打开手机端" FontSize="12" Foreground="#8794A8"
                                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="外网访问">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,20">
                        <TextBlock Text="老师不在学校 WiFi 里也想发消息，就靠这条隧道。填一条启动命令即可，程序会负责把它跑起来并抓出公网地址。"
                                   Foreground="#4A5568" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <TextBlock Text="启动命令（{app} = 软件所在目录，{port} = 端口号）" Style="{StaticResource Label}" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtTunnelCmd" Height="64" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                        <TextBlock Text="默认指向软件目录下的 frp 文件夹，整个文件夹拷到别的电脑也不用改。"
                                   Foreground="#8794A8" FontSize="12.5" TextWrapping="Wrap" Margin="0,-10,0,4"/>
                        <TextBlock Text="用 cloudflared 的话填：cloudflared tunnel --url http://127.0.0.1:{port}"
                                   Foreground="#8794A8" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <TextBlock Text="公网地址" Style="{StaticResource Label}" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtManualUrl" Margin="0,0,0,6"/>
                        <TextBlock Text="FRP 类客户端启动后不会打印公网地址，需要在这里手动填一次；手机端二维码和外网入口都用它。"
                                   Foreground="#8794A8" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <CheckBox x:Name="ChkTunnelAuto" Content="班牌启动时自动开启隧道"/>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="BtnTunnelStart" Content="启动隧道" Click="OnTunnelStart"/>
                            <Button x:Name="BtnTunnelStop" Content="停止" Click="OnTunnelStop"/>
                            <Button x:Name="BtnTunnelDefault" Content="恢复默认命令" Click="OnTunnelDefault"/>
                        </StackPanel>

                        <TextBlock x:Name="TxtTunnelState" Foreground="#4A5568" Margin="0,14,0,6" TextWrapping="Wrap"/>
                        <TextBox x:Name="TxtTunnelLog" Height="140" IsReadOnly="True" Background="#F2F5FA"
                                 FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <Border Grid.Row="1" Background="White" BorderBrush="#E1E7F0" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <TextBlock x:Name="TxtSaveHint" Foreground="#8794A8" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnOpenData" Content="打开数据目录" Click="OnOpenData"/>
                    <Button x:Name="BtnSave" Content="保存并应用" Click="OnSave" Background="#2F6BFF" Foreground="White" BorderThickness="0"/>
                    <Button x:Name="BtnClose" Content="关闭" Click="OnClose" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
