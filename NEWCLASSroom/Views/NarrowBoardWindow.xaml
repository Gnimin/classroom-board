<local:BoardWindowBase x:Class="NEWCLASSroom.Views.NarrowBoardWindow"
        xmlns:local="clr-namespace:NEWCLASSroom.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="班级班牌"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <local:BoardWindowBase.Resources>
        <LinearGradientBrush x:Key="BoardBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#101A2C" Offset="0"/>
            <GradientStop Color="#0C1220" Offset="0.55"/>
            <GradientStop Color="#111B30" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1A2439" Offset="0"/>
            <GradientStop Color="#161E30" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4D8DFF" Offset="0"/>
            <GradientStop Color="#6C6BE8" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0E1522"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#EDF2FB"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8EA0BE"/>
        <SolidColorBrush x:Key="TextFaint" Color="#5C6C88"/>
        <SolidColorBrush x:Key="CardBorder" Color="#26324A"/>
        <SolidColorBrush x:Key="TrackBrush" Color="#22304A"/>
        <SolidColorBrush x:Key="ToastBrush" Color="#CC1B2540"/>
        <SolidColorBrush x:Key="BadgeBrush" Color="#4D8DFF"/>
    </local:BoardWindowBase.Resources>

    <Viewbox Stretch="Uniform">
        <!-- 800×900 正好是 16:9 屏幕右半边（960×1080）的等比尺寸 -->
        <Grid x:Name="CanvasRoot" Width="800" Height="900" Background="{DynamicResource BoardBackground}">

            <Rectangle Height="6" VerticalAlignment="Top" Fill="{DynamicResource AccentBrush}"/>

            <Grid x:Name="ContentRoot" Margin="30,24,30,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶部：学校 · 班级 · 日期 -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="7" Height="34" CornerRadius="3.5" Background="{DynamicResource AccentBrush}"
                                VerticalAlignment="Center"/>
                        <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtSchool" Text="迎春中学" FontSize="14" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock x:Name="TxtClass" Text="六年级(1)班" FontSize="26" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtDate" Text="2026年11月8日" FontSize="17" Foreground="{DynamicResource TextPrimary}"
                                   HorizontalAlignment="Right"/>
                        <TextBlock x:Name="TxtWeekday" Text="星期日" FontSize="13" Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Right" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 主体：左栏放时间和状态，右栏整条给课表 -->
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 左栏 -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock x:Name="TxtClock" Text="14:21" FontFamily="Consolas, Microsoft YaHei UI"
                                       FontSize="72" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                                       Margin="0,0,0,-10"/>
                            <TextBlock x:Name="TxtSeconds" Text=":49" FontFamily="Consolas" FontSize="24"
                                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Bottom" Margin="6,0,0,12"/>
                            <TextBlock x:Name="TxtAmPm" Text="下午" FontSize="12" Visibility="Collapsed"
                                       Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>

                        <Border x:Name="StatusCard" Grid.Row="1" Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="18"
                                Margin="0,12,0,0" Padding="18,16,18,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Border x:Name="BadgeBox" Background="{DynamicResource BadgeBrush}" CornerRadius="8"
                                            Padding="8,3">
                                        <TextBlock x:Name="TxtBadge" Text="正在上" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </Border>
                                    <TextBlock x:Name="TxtSub" Text="第6节 · 14:20 - 15:00" FontSize="12"
                                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                               Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <TextBlock x:Name="TxtHeadline" Grid.Row="1" Text="第6节" FontSize="56" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>

                                <StackPanel Grid.Row="2">
                                    <TextBlock x:Name="TxtCountdown" Text="距下课 38:10" FontSize="18"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                                    <Border x:Name="ProgressTrack" Height="8" CornerRadius="4"
                                            Background="{DynamicResource TrackBrush}">
                                        <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="4"
                                                Background="{DynamicResource AccentBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="FooterCard" Grid.Row="2" Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="16"
                                Margin="0,12,0,0" Padding="16,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock x:Name="TxtDutyTitle" Text="今日值日" FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock x:Name="TxtDutyDay" Text="星期日" FontSize="12"
                                               Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled" VerticalAlignment="Top">
                                    <WrapPanel x:Name="DutyPanel" Orientation="Horizontal"/>
                                </ScrollViewer>

                                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                    <TextBlock x:Name="TxtLanUrl" Text="手机端未启动" FontSize="11"
                                               Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TxtModeHint" Text="" FontSize="11"
                                               Foreground="{DynamicResource TextFaint}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 右栏：整条课表 -->
                    <Border x:Name="TimetableCard" Grid.Column="2" Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="18"
                            Padding="18,14,18,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="今日课表" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="TxtTimetableHint" Text="共 8 节" FontSize="12"
                                           Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel x:Name="TimetableRows" Grid.Row="1" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Border x:Name="ToastBox" Background="{DynamicResource ToastBrush}" CornerRadius="12" Padding="20,10"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,120" Opacity="0"
                    IsHitTestVisible="False">
                <TextBlock x:Name="TxtToast" Text="" FontSize="16" Foreground="#FFFFFF"/>
            </Border>
        </Grid>
    </Viewbox>
</local:BoardWindowBase>
